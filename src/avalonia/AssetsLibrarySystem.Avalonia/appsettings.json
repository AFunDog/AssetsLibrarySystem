{
  "Runtime": {
    "DataRoot": ""
  },
  "SearchModels": {
    "EmbeddingProvider": "dashscope",
    "EmbeddingModel": "text-embedding-v4",
    "EmbeddingDimensions": 1024,
    "EmbeddingModels": {
      "DashScope": {
        "Model": "text-embedding-v4",
        "Dimensions": 1024
      }
    },
    "RerankProvider": "dashscope",
    "RerankModel": "qwen3-rerank",
    "RerankModels": {
      "DashScope": {
        "Model": "qwen3-rerank"
      }
    },
    "Pricing": {
      "EmbeddingPricePerMillion": 0.7,
      "RerankPricePerMillion": 0.2
    }
  },
  "SearchParameters": {
    "CandidateTopK": 20,
    "ExpandedCandidateTopK": 160,
    "RerankTopK": 50,
    "FinalTopK": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/avalonia-.log",
          "restrictedToMinimumLevel": "Verbose",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  }
}
