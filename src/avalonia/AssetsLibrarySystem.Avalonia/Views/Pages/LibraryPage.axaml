<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AssetsLibrarySystem.Avalonia.ViewModels"
             xmlns:pagevm="using:AssetsLibrarySystem.Avalonia.ViewModels"
             xmlns:models="using:AssetsLibrarySystem.Avalonia.Models"
             xmlns:lucide="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
             xmlns:converters="using:AssetsLibrarySystem.Avalonia.Converters"
             x:Class="AssetsLibrarySystem.Avalonia.Views.Pages.LibraryPage"
             x:DataType="pagevm:LibraryPageViewModel"
             FontSize="14">
    <UserControl.Resources>
        <converters:StatusColorConverter x:Key="StatusColorConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
    </UserControl.Resources>

    <Design.DataContext>
        <pagevm:LibraryPageViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.page-card">
            <Setter Property="Background" Value="{DynamicResource AppSoftSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.sub-card">
            <Setter Property="Background" Value="{DynamicResource AppWindowBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="Button.primary-action">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Button.primary-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary-action:pressed">
            <Setter Property="Background" Value="{DynamicResource AppAccentPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.secondary-action">
            <Setter Property="Background" Value="{DynamicResource AppSoftSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Button.result-action">
            <Setter Property="Background" Value="{DynamicResource AppSoftSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.section-subtitle">
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBox.compact-input">
            <Setter Property="Background" Value="{DynamicResource AppSoftSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="28,18,28,28">
            <Border Classes="page-card">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="34"
                                   FontWeight="SemiLight"
                                   Foreground="{DynamicResource AppTextBrush}"
                                   Text="素材库" />
                        <TextBlock Classes="section-subtitle"
                                   Text="中央用大图标浏览素材库、目录和文件，右键可定位位置或加入描述任务队列。" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="primary-action"
                                Command="{Binding QueueDescriptionsForSelectionCommand}"
                                Content="描述当前范围" />
                        <Button Classes="secondary-action"
                                Command="{Binding QueueSelectedDescriptionCommand}"
                                Content="描述当前素材" />
                        <Button Classes="secondary-action"
                                Command="{Binding VectorizeDescriptionsCommand}"
                                Content="批量向量化" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,332" ColumnSpacing="12">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                    <Border Classes="page-card">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="primary-action"
                                        Click="AddLibraryFolder_Click"
                                        Content="添加目录" />
                                <Button Classes="secondary-action"
                                        Command="{Binding Workspace.ScanSelectedLibraryCommand}"
                                        Content="扫描当前" />
                                <Button Classes="secondary-action"
                                        Command="{Binding Workspace.NavigateUpCommand}"
                                        IsEnabled="{Binding Workspace.CanNavigateUp}"
                                        Content="上一级" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Classes="eyebrow" Text="资源管理器" />
                                <TextBlock Classes="section-title" Text="{Binding Workspace.ExplorerTitle}" />
                                <TextBlock Classes="section-subtitle" Text="{Binding Workspace.ExplorerSummary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="eyebrow" Text="当前位置" HorizontalAlignment="Right" />
                                <TextBlock Foreground="{DynamicResource AppAccentBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Right"
                                           Text="{Binding Workspace.ExplorerPath}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Classes="sub-card">
                        <TextBlock Foreground="{DynamicResource AppSecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="大图标视图，点击文件夹继续进入，点击文件可在右侧查看详情。" />
                    </Border>

                    <!-- 筛选工具栏 -->
                    <Border Grid.Row="2" Classes="sub-card" Padding="8,6">
                        <Grid ColumnDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto" ColumnSpacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="eyebrow" Text="类型" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Workspace.FilterAssetTypeOptions}"
                                          SelectedItem="{Binding Workspace.FilterAssetType, Mode=TwoWay}"
                                          MinWidth="80"
                                          FontSize="12"
                                          Padding="4,2"
                                          Background="{DynamicResource AppWindowBackgroundBrush}"
                                          BorderBrush="{DynamicResource AppBorderBrush}"
                                          Foreground="{DynamicResource AppTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="eyebrow" Text="状态" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Workspace.FilterStatusOptions}"
                                          SelectedItem="{Binding Workspace.FilterStatus, Mode=TwoWay}"
                                          MinWidth="80"
                                          FontSize="12"
                                          Padding="4,2"
                                          Background="{DynamicResource AppWindowBackgroundBrush}"
                                          BorderBrush="{DynamicResource AppBorderBrush}"
                                          Foreground="{DynamicResource AppTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="eyebrow" Text="排序" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Workspace.FilterSortByOptions}"
                                          SelectedItem="{Binding Workspace.FilterSortBy, Mode=TwoWay}"
                                          MinWidth="70"
                                          FontSize="12"
                                          Padding="4,2"
                                          Background="{DynamicResource AppWindowBackgroundBrush}"
                                          BorderBrush="{DynamicResource AppBorderBrush}"
                                          Foreground="{DynamicResource AppTextBrush}" />
                                <Button Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Padding="2"
                                        Command="{Binding Workspace.ToggleSortDirectionCommand}"
                                        ToolTip.Tip="切换排序方向">
                                    <lucide:LucideIcon Kind="ArrowUpDown" Size="12" />
                                </Button>
                            </StackPanel>
                            <!-- 视图模式切换 -->
                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Background="Transparent"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4"
                                        Command="{Binding Workspace.SwitchToIconViewCommand}"
                                        ToolTip.Tip="大图标视图"
                                        Opacity="{Binding Workspace.IsIconView, Converter={StaticResource BoolToOpacityConverter}}">
                                    <lucide:LucideIcon Kind="AppWindow" Size="14" />
                                </Button>
                                <Button Background="Transparent"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4"
                                        Command="{Binding Workspace.SwitchToListViewCommand}"
                                        ToolTip.Tip="列表视图"
                                        Opacity="{Binding Workspace.IsListView, Converter={StaticResource BoolToOpacityConverter}}">
                                    <lucide:LucideIcon Kind="List" Size="14" />
                                </Button>
                                <Button Background="Transparent"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4"
                                        Command="{Binding Workspace.SwitchToDetailViewCommand}"
                                        ToolTip.Tip="详情视图"
                                        Opacity="{Binding Workspace.IsDetailView, Converter={StaticResource BoolToOpacityConverter}}">
                                    <lucide:LucideIcon Kind="Table" Size="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Classes="page-card"
                              x:Name="ExplorerDropArea">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                            <!-- 大图标视图 -->
                            <ItemsControl ItemsSource="{Binding Workspace.FilteredExplorerItems}"
                                          IsVisible="{Binding Workspace.IsIconView}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AssetLibraryTreeNode">
                                        <Button Classes="secondary-action"
                                                Margin="0,0,12,12"
                                                Padding="12"
                                                CornerRadius="8"
                                                Width="180"
                                                HorizontalAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Click="OpenExplorerItem_Click"
                                                CommandParameter="{Binding}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="定位文件或文件夹位置"
                                                              Click="RevealInExplorer_Click"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="加入描述任务队列"
                                                              Click="QueueDescriptionForNode_Click"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="向量化当前素材/文件夹"
                                                              Click="VectorizeDescriptionsForNode_Click"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="删除描述记录"
                                                              Click="DeleteDescriptionForNode_Click"
                                                              CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="编辑标签"
                                                              Click="EditTags_Click"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="重命名"
                                                              Click="RenameNode_Click"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="删除"
                                                              Click="DeleteNode_Click"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel Spacing="8">
                                                <Border Background="{DynamicResource AppAccentSurfaceBrush}"
                                                        BorderBrush="{DynamicResource AppAccentBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="14"
                                                        HorizontalAlignment="Left">
                                                    <Grid>
                                                        <Image Source="{Binding Thumbnail}"
                                                               Width="56" Height="56"
                                                               Stretch="Uniform"
                                                               IsVisible="{Binding HasThumbnail}" />
                                                        <lucide:LucideIcon Kind="{Binding IconKind}"
                                                                           Size="28"
                                                                           IsVisible="{Binding !HasThumbnail}" />
                                                        <Ellipse Width="8" Height="8"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Top"
                                                                 Margin="4,-4,0,0"
                                                                 IsVisible="{Binding ShowStatusDot}"
                                                                 Fill="{Binding StatusColorKey, Converter={StaticResource StatusColorConverter}}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Foreground="{DynamicResource AppTextBrush}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding DisplayName}" />
                                                    <TextBlock Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding TypeLabel}" />
                                                    <TextBlock Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding PathLabel}" />
                                                </StackPanel>
                                                <TextBlock Foreground="{DynamicResource AppAccentBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding MetaLabel}" />
                                                <TextBlock Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding StatusLabel}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 列表视图 -->
                            <ItemsControl ItemsSource="{Binding Workspace.FilteredExplorerItems}"
                                          IsVisible="{Binding Workspace.IsListView}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AssetLibraryTreeNode">
                                        <Button Classes="secondary-action"
                                                Margin="0,0,0,2"
                                                Padding="8,6"
                                                CornerRadius="4"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="OpenExplorerItem_Click"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="32,*,Auto,Auto,Auto" ColumnSpacing="8">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Width="24" Height="24"
                                                           Stretch="Uniform"
                                                           IsVisible="{Binding HasThumbnail}" />
                                                    <lucide:LucideIcon Kind="{Binding IconKind}"
                                                                       Size="16"
                                                                       IsVisible="{Binding !HasThumbnail}" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Spacing="0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding PathLabel}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding TypeLabel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding MetaLabel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AppAccentBrush}"
                                                           VerticalAlignment="Center" />
                                                <Ellipse Grid.Column="4"
                                                         Width="6" Height="6"
                                                         VerticalAlignment="Center"
                                                         IsVisible="{Binding ShowStatusDot}"
                                                         Fill="{Binding StatusColorKey, Converter={StaticResource StatusColorConverter}}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 详情视图：多列表格行 -->
                            <ItemsControl ItemsSource="{Binding Workspace.FilteredExplorerItems}"
                                          IsVisible="{Binding Workspace.IsDetailView}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AssetLibraryTreeNode">
                                        <Button Classes="secondary-action"
                                                Margin="0,0,0,2"
                                                Padding="8,6"
                                                CornerRadius="4"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="OpenExplorerItem_Click"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="28,*,80,70,90,120" ColumnSpacing="10">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Width="22" Height="22"
                                                           Stretch="Uniform"
                                                           IsVisible="{Binding HasThumbnail}" />
                                                    <lucide:LucideIcon Kind="{Binding IconKind}"
                                                                       Size="14"
                                                                       IsVisible="{Binding !HasThumbnail}" />
                                                </Grid>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding TypeLabel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding SizeLabel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding MetaLabel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AppAccentBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6"
                                                             IsVisible="{Binding ShowStatusDot}"
                                                             Fill="{Binding StatusColorKey, Converter={StaticResource StatusColorConverter}}" />
                                                    <TextBlock Text="{Binding PathLabel}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                    <!-- 预览区域 -->
                    <Border Classes="sub-card"
                            Padding="8"
                            IsVisible="{Binding AssetDetail.HasPreview}">
                        <Grid>
                            <!-- 图片预览 -->
                            <Image Source="{Binding AssetDetail.PreviewImage}"
                                   MaxHeight="160"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding AssetDetail.IsImagePreview}" />
                            <!-- 文本预览 -->
                            <ScrollViewer IsVisible="{Binding AssetDetail.IsTextPreview}"
                                          MaxHeight="160"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding AssetDetail.PreviewText}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppTextBrush}" />
                            </ScrollViewer>
                            <!-- 视频/音频占位 -->
                            <Border IsVisible="{Binding AssetDetail.IsMediaPlaceholder}"
                                    Height="80"
                                    Background="{DynamicResource AppAccentSurfaceBrush}"
                                    CornerRadius="6"
                                    HorizontalAlignment="Center">
                                <StackPanel Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <lucide:LucideIcon Kind="File" Size="32" />
                                    <TextBlock Text="{Binding AssetDetail.SelectedAssetType, StringFormat={}{0} 素材}"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}"
                                               FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Classes="page-card">
                        <Grid ColumnDefinitions="200,*" ColumnSpacing="12">
                            <!-- 左侧：基本信息 -->
                            <Border Classes="sub-card">
                                <StackPanel Spacing="8">
                                    <StackPanel>
                                        <TextBlock Classes="eyebrow" Text="类型" />
                                        <TextBlock Foreground="{DynamicResource AppTextBrush}"
                                                   FontSize="24" FontWeight="SemiLight"
                                                   Text="{Binding AssetDetail.SelectedAssetType}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="eyebrow" Text="子类型" />
                                        <TextBlock Foreground="{DynamicResource AppTextBrush}"
                                                   Text="{Binding AssetDetail.SelectedAssetSubtype}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="eyebrow" Text="状态" />
                                        <TextBlock Foreground="{DynamicResource AppTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding AssetDetail.SelectedAssetAiState}" />
                                    </StackPanel>
                                    <!-- 标签编辑 -->
                                    <StackPanel>
                                        <TextBlock Classes="eyebrow" Text="标签" />
                                        <ItemsControl ItemsSource="{Binding AssetDetail.SelectedAssetTags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource AppAccentSurfaceBrush}"
                                                            CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                            <TextBlock Text="{Binding .}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource AppTextBrush}" />
                                                            <Button Grid.Column="1"
                                                                    Background="Transparent"
                                                                    BorderBrush="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="2"
                                                                    FontSize="10"
                                                                    Command="{Binding AssetDetail.RemoveTagCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type pagevm:LibraryPageViewModel}}}"
                                                                    CommandParameter="{Binding .}"
                                                                    Content="×"
                                                                    ToolTip.Tip="删除标签" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="0,4,0,0">
                                            <TextBox Text="{Binding AssetDetail.NewTagText}"
                                                     PlaceholderText="添加标签..."
                                                     Classes="compact-input" />
                                            <Button Grid.Column="1"
                                                    Classes="primary-action"
                                                    Command="{Binding AssetDetail.AddTagCommand}"
                                                    Content="添加" />
                                        </Grid>
                                    </StackPanel>
                                    <!-- 操作按钮 -->
                                    <StackPanel Spacing="4" Margin="0,8,0,0">
                                        <Button Classes="secondary-action"
                                                Command="{Binding AssetDetail.DeleteAssetCommand}"
                                                Content="删除素材"
                                                ToolTip.Tip="删除当前素材及其描述和向量记录" />
                                        <Button Classes="secondary-action"
                                                Command="{Binding AssetDetail.DeleteLibraryCommand}"
                                                Content="删除素材库"
                                                ToolTip.Tip="删除当前素材库及其所有素材" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- 右侧：角度描述列表 -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8">
                                    <TextBox Text="{Binding AssetDetail.EditDescriptionText}"
                                             PlaceholderText="编辑主描述文本后可保存；结构化角度列表在下方只读展示。"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="88"
                                             MaxHeight="160" />
                                    <Button Classes="secondary-action"
                                            Command="{Binding AssetDetail.SaveDescriptionCommand}"
                                            Content="保存描述修改"
                                            IsEnabled="{Binding AssetDetail.EditDescriptionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <ItemsControl ItemsSource="{Binding AssetDetail.SelectedAssetDescriptionAngles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="sub-card" Margin="0,0,0,8">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontWeight="SemiBold" FontSize="14"
                                                                   Foreground="{DynamicResource AppTextBrush}" />
                                                        <TextBlock Classes="eyebrow" Grid.Column="1" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Text}"
                                                               TextWrapping="Wrap"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource AppTextBrush}" />
                                                    <WrapPanel>
                                                        <ItemsControl ItemsSource="{Binding Tags}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource AppSoftSurfaceBrush}"
                                                                            CornerRadius="4" Padding="8,4" Margin="2">
                                                                        <TextBlock Text="{Binding}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource AppTextBrush}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Classes="page-card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="eyebrow" Text="动态" />
                            <TextBlock Classes="section-title" Text="活动纪要" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="240"
                                          >
                                <ItemsControl ItemsSource="{Binding ActivityFeed}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ActivityFeedEntry">
                                            <Border Classes="sub-card" Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                    <TextBlock Text="{Binding TimeText}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                               VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="1"
                                                               Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Message}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
