<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AssetsLibrarySystem.Avalonia.ViewModels"
             x:Class="AssetsLibrarySystem.Avalonia.App"
             x:DataType="vm:DesktopShellViewModel"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />

        <!-- 全局 GridSplitter 样式：侧边分隔条，所有页面通过 Classes="side-splitter" 复用 -->
        <!-- 默认完全隐藏，仅悬停/拖动时浮现圆角胶囊手柄 -->
        <Style Selector="GridSplitter.side-splitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Border Name="SplitterLine"
                                Background="{DynamicResource AppBorderBrush}"
                                Width="5"
                                Height="36"
                                CornerRadius="2.5"
                                Opacity="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="GridSplitter.side-splitter:pointerover /template/ Border#SplitterLine">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="GridSplitter.side-splitter:active /template/ Border#SplitterLine">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- 水平分割条：上下拖拽调整面板高度，默认隐藏，悬停/拖动时浮现胶囊手柄 -->
        <Style Selector="GridSplitter.side-splitter-h">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Border Name="SplitterLine"
                                Background="{DynamicResource AppBorderBrush}"
                                Width="36"
                                Height="5"
                                CornerRadius="2.5"
                                Opacity="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="GridSplitter.side-splitter-h:pointerover /template/ Border#SplitterLine">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="GridSplitter.side-splitter-h:active /template/ Border#SplitterLine">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppAccentBrush"
                                     Color="{DynamicResource SystemAccentColor}" />

                    <SolidColorBrush x:Key="AppAccentHoverBrush"
                                     Color="{DynamicResource SystemAccentColorLight1}" />

                    <SolidColorBrush x:Key="AppAccentPressedBrush"
                                     Color="{DynamicResource SystemAccentColorDark1}" />

                    <SolidColorBrush x:Key="AppAccentSurfaceBrush"
                                     Color="{DynamicResource SystemAccentColor}"
                                     Opacity="0.12" />

                    <!-- Windows 11 base/content layering -->
                    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSoftSurfaceBrush" Color="#F9F9F9" />

                    <!-- 中性边框 -->
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#E5E5E5" />

                    <!-- 中性文字 -->
                    <SolidColorBrush x:Key="AppTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#666666" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#444444" />

                    <!-- 徽章/标签背景 -->
                    <SolidColorBrush x:Key="AppBadgeBrush" Color="#EEEEEE" />

                    <!-- 状态颜色 -->
                    <SolidColorBrush x:Key="StatusDescribedBrush" Color="#52C41A" />
                    <SolidColorBrush x:Key="StatusVectorizedBrush" Color="#4C94FF" />
                    <SolidColorBrush x:Key="StatusPendingBrush" Color="#B8B8B8" />
                    <SolidColorBrush x:Key="StatusFailedBrush" Color="#FF4D4F" />
                    <SolidColorBrush x:Key="StatusProcessingBrush" Color="#FA8C16" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppAccentBrush"
                                     Color="{DynamicResource SystemAccentColor}" />

                    <SolidColorBrush x:Key="AppAccentHoverBrush"
                                     Color="{DynamicResource SystemAccentColorLight1}" />

                    <SolidColorBrush x:Key="AppAccentPressedBrush"
                                     Color="{DynamicResource SystemAccentColorDark1}" />

                    <SolidColorBrush x:Key="AppAccentSurfaceBrush"
                                     Color="{DynamicResource SystemAccentColor}"
                                     Opacity="0.14" />

                    <!-- Windows 11 base/content layering -->
                    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#242424" />
                    <SolidColorBrush x:Key="AppSoftSurfaceBrush" Color="#2B2B2B" />

                    <!-- 中性边框 -->
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#383838" />

                    <!-- 中性文字 -->
                    <SolidColorBrush x:Key="AppTextBrush" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#B8B8B8" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#8A8A8A" />

                    <!-- 徽章/标签背景 -->
                    <SolidColorBrush x:Key="AppBadgeBrush" Color="#242424" />

                    <!-- 状态颜色 -->
                    <SolidColorBrush x:Key="StatusDescribedBrush" Color="#52C41A" />
                    <SolidColorBrush x:Key="StatusVectorizedBrush" Color="#4C94FF" />
                    <SolidColorBrush x:Key="StatusPendingBrush" Color="#555555" />
                    <SolidColorBrush x:Key="StatusFailedBrush" Color="#FF4D4F" />
                    <SolidColorBrush x:Key="StatusProcessingBrush" Color="#FA8C16" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/avalonia-logo.ico"
                      ToolTipText="{Binding TrayTitle}"
                      Command="{Binding ToggleQuickSearchWindowCommand}">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{Binding TrayTitle}"
                                        IsEnabled="False" />
                        <NativeMenuItem Header="{Binding TrayStatusTitle}"
                                        IsEnabled="False" />
                        <NativeMenuItem Header="{Binding TrayStatusDetail}"
                                        IsEnabled="False" />
                        <NativeMenuItem Header="{Binding TrayHotkeyHint}"
                                        IsEnabled="False" />
                        <NativeMenuItem Header="{Binding TrayActionHint}"
                                        IsEnabled="False" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="打开快速检索"
                                        Command="{Binding ShowQuickSearchWindowCommand}" />
                        <NativeMenuItem Header="打开主窗口"
                                        Command="{Binding ShowMainWindowCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="退出"
                                        Command="{Binding ExitApplicationCommand}" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
